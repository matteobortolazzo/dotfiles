{{- /* dig, not .org, so machines whose chezmoi.toml predates the org prompt still apply. */ -}}
{{- $org := dig "org" "" . -}}
{{- /* No `op` guard here on purpose: .chezmoiignore owns the skip decision and
       ignores this target outright when `op` cannot authenticate, so the file is
       left untouched rather than overwritten with a secretless placeholder. */ -}}
# Secrets managed by 1Password — populated by chezmoi apply
# To update values, edit items in 1Password, then re-run chezmoi apply

# OpenAI
export OPENAI_API_KEY={{ onepasswordRead "op://Private/OpenAI/ApiKey" | shellQuote }}

# Context7
export CONTEXT7_API_KEY={{ onepasswordRead "op://Private/Context7 API Key/credential" | shellQuote }}

# Resend
export RESEND_API_KEY={{ onepasswordRead "op://Private/Resend/ApiKey" | shellQuote }}
export RESEND_FROM_ADDRESS={{ onepasswordRead "op://Private/Resend/FromAddress" | shellQuote }}

# Velka (prod)
export CAPGO_TOKEN={{ onepasswordRead "op://Private/velka-prod/Mobile/Capgo App Developer Key" | shellQuote }}
export VELKA_APPINSIGHTS_CONNECTION_STRING={{ onepasswordRead "op://Private/velka-prod/Azure/Application Insight Connection String" | shellQuote }}
# Capgo v2 OTA signing keys: paths, not PEM, so ui.sh never materializes a temp copy.
export CAPGO_KEY_V2_COACH="$HOME/.config/velka/capgo/coach.key"
export CAPGO_KEY_V2_CLIENT="$HOME/.config/velka/capgo/client.key"
# Android upload keystore (PKCS12: the key password is the store password).
export ANDROID_KEYSTORE_FILE="$HOME/.config/velka/android/velka-release.keystore"
export ANDROID_KEYSTORE_PASSWORD={{ onepasswordRead "op://Private/velka-prod/Mobile/Android Keystore Password" | shellQuote }}
export ANDROID_KEY_ALIAS=velka-release
export ANDROID_KEY_PASSWORD="$ANDROID_KEYSTORE_PASSWORD"
{{- if $org }}

# Azure DevOps ({{ $org }})
export AZURE_DEVOPS_EXT_PAT={{ onepasswordRead (printf "op://Private/%s/AdoPat" $org) | shellQuote }}
{{- end }}
