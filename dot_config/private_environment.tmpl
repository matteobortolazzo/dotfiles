{{- /* dig, not .org, so machines whose chezmoi.toml predates the org prompt still apply. */ -}}
{{- $org := dig "org" "" . -}}
{{- /* No `op` guard here on purpose: .chezmoiignore owns the skip decision and
       ignores this target outright when `op` cannot authenticate, so the file is
       left untouched rather than overwritten with a secretless placeholder. */ -}}
# Secrets managed by 1Password — populated by chezmoi apply
# To update values, edit items in 1Password, then re-run chezmoi apply

# OpenAI
export OPENAI_API_KEY="{{ onepasswordRead "op://Private/OpenAI/ApiKey" }}"

# Context7
export CONTEXT7_API_KEY="{{ onepasswordRead "op://Private/Context7 API Key/credential" }}"

# Resend
export RESEND_API_KEY="{{ onepasswordRead "op://Private/Resend/ApiKey" }}"
export RESEND_FROM_ADDRESS="{{ onepasswordRead "op://Private/Resend/FromAddress" }}"

# Velka (prod)
export CAPGO_TOKEN="{{ onepasswordRead "op://Private/velka-prod/Mobile/Capgo App Developer Key" }}"
export VELKA_APPINSIGHTS_CONNECTION_STRING="{{ onepasswordRead "op://Private/velka-prod/Azure/Application Insight Connection String" }}"
{{- if $org }}

# Azure DevOps ({{ $org }})
export AZURE_DEVOPS_EXT_PAT="{{ onepasswordRead (printf "op://Private/%s/AdoPat" $org) }}"
{{- end }}
