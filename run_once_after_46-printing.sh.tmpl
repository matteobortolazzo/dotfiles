#!/usr/bin/env bash
{{ if and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id") (eq .chezmoi.osRelease.id "cachyos" "arch") (eq .profile "main") -}}
set -euo pipefail

# Printing + scanning: CUPS daemon + Avahi/nss-mdns for driverless IPP
# (AirPrint) discovery over the network, ipp-usb for the same driverless path
# over a USB cable, and hplip for HP devices that predate IPP Everywhere.
# Packages come from arch-system.txt (cups, cups-pdf, avahi, nss-mdns, ipp-usb,
# hplip, sane, sane-airscan) and arch-desktop.txt (system-config-printer,
# simple-scan). Add a printer afterwards via system-config-printer, the web UI
# at http://localhost:631, `lpadmin`, or `hp-setup -i` for HP over USB.
#
# ipp-usb has no enable step: its udev rule (ENV{SYSTEMD_WANTS}) starts the
# service when a compatible printer is plugged in. A printer already connected
# when ipp-usb was installed needs a replug or `sudo systemctl start ipp-usb`.

if command -v cupsd >/dev/null 2>&1; then
  sudo systemctl enable --now cups.socket
else
  echo "cups not installed — skipping (run: sudo pacman -S cups cups-pdf)"
fi

if command -v avahi-daemon >/dev/null 2>&1; then
  sudo systemctl enable --now avahi-daemon.service
else
  echo "avahi not installed — skipping (run: sudo pacman -S avahi nss-mdns)"
fi

# Wire nss-mdns into NSS so `.local` printer/host names resolve. Idempotent:
# only edits the hosts line if no mdns module is present yet.
nsswitch=/etc/nsswitch.conf
if [ -f "$nsswitch" ] && ! grep -qE '^hosts:.*mdns' "$nsswitch"; then
  if grep -qE '^hosts:.*\bresolve\b' "$nsswitch"; then
    sudo sed -i -E '/^hosts:/ s/\bresolve\b/mdns_minimal [NOTFOUND=return] resolve/' "$nsswitch"
  else
    sudo sed -i -E '/^hosts:/ s/\bdns\b/mdns_minimal [NOTFOUND=return] dns/' "$nsswitch"
  fi
  echo "added mdns_minimal to $nsswitch hosts line"
fi

# Direct device access: hplip's USB backend wants `lp`, and the sane-backends
# udev rules tag some scanners GROUP="scanner" rather than relying on uaccess.
# Idempotent; takes effect on the next login.
me=$(id -un)
for group in lp scanner; do
  if getent group "$group" >/dev/null 2>&1 && ! id -nG "$me" | grep -qw "$group"; then
    sudo usermod -aG "$group" "$me"
    echo "added $me to the $group group — log out and back in for it to apply"
  fi
done
{{ end -}}
