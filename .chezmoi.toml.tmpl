{{- /* profile = platform (packages, compositor, interop). org = ownership. gaming = role.
       Keep them orthogonal: the gaming desktop is the same platform as the laptop
       (CachyOS + niri + DMS + greetd), so it stays profile "main" and only adds the
       gaming role on top. Templates read it with `dig "gaming" false .`, not `.gaming`,
       because .chezmoi.toml.tmpl runs on `chezmoi init` only — machines whose config
       predates this prompt must keep applying. */ -}}
{{- $profile := promptChoiceOnce . "profile" "Machine profile" (list "main" "wsl" "mac") -}}
{{- $org := promptStringOnce . "org" "Work org, must match the 1Password item name in the Private vault (blank for personal)" "" -}}
{{- $gaming := promptBoolOnce . "gaming" "Gaming host (Steam, gamescope session, Fanatec sim rig, Sunshine, sshd)" false -}}

[data]
  profile = {{ $profile | quote }}
  org = {{ $org | quote }}
  gaming = {{ $gaming }}

[onepassword]
  mode = "account"
