{{- /* profile = platform (packages, compositor, interop). org = ownership.
       gaming = role. The gaming desktop is the
       same platform as the laptop (CachyOS + niri + DMS + greetd), so it stays
       profile "main" and only layers gaming/hardware options on top. Developer
       tools are shared except on a Mac with macMode = "minimal". SSH access
       remains shared. Old dev values are ignored. `devHost` names the
       box you reach, named once here instead of hardcoded in the ssh config, so
       renaming the desktop is a one-line change and the alias is skipped on the
       machine that matches it. `devUser` is the login on that box, for clients
       whose local username differs (the Mac); blank means ssh's default, the
       local username, which is already right between the Linux machines.
       Templates read the role vars with
       `dig "gaming" false .`, not `.gaming`, because .chezmoi.toml.tmpl runs on
       `chezmoi init` only — machines whose config predates a prompt must keep
       applying.

       `headless` is a boot policy rather than a role: it adds a second limine
       entry that boots to multi-user.target, so the box comes up as an SSH
       target with no greetd, no compositor and no GPU session, and the desktop
       is started on demand. It defaults to false: SSH access does not imply
       booting without a desktop.

       `ups` is likewise a property of the machine rather than a role: it says a
       UPS is on this box's USB, which is what decides whether NUT is installed
       and whether this is the host that gets to tell the UPS to cut power. It
       is not implied by SSH access or `headless` — an unattended box with no UPS
       must not ship a monitor that shuts it down.

       `deck` is the same shape as `ups`: a hardware fact, not a role. It says a
       Stream Deck is plugged into this box, which is what decides whether
       deckd is built and its udev rule + system unit are installed. Nothing
       else implies it — the deck is the headless desktop's screen today, but
       `headless` without a deck is a perfectly good box, and a deck on a box
       that boots graphical still works. */ -}}
{{- $profile := promptChoiceOnce . "profile" "Machine profile" (list "main" "wsl" "mac") -}}
{{- $macMode := "full-dev" -}}
{{- if eq $profile "mac" -}}
{{- $macMode = promptChoiceOnce . "macMode" "Mac tools: minimal (browser + iPhone builds) or full-dev" (list "minimal" "full-dev") -}}
{{- end -}}
{{- $org := promptStringOnce . "org" "Work org, must match the 1Password item name in the Private vault (blank for personal)" "" -}}
{{- $gaming := false -}}
{{- $ups := false -}}
{{- $deck := false -}}
{{- $tuxedo := false -}}
{{- $headless := false -}}
{{- if and (eq .chezmoi.os "linux") (eq $profile "main") -}}
{{- $gaming = promptBoolOnce . "gaming" "Gaming host (Steam, gamescope session, Fanatec sim rig, Sunshine)" false -}}
{{- $ups = promptBoolOnce . "ups" "UPS attached by USB (NUT monitoring + clean shutdown on a power cut)" false -}}
{{- $deck = promptBoolOnce . "deck" "Stream Deck plugged into this box (deckd status panel)" false -}}
{{- $tuxedo = promptBoolOnce . "tuxedo" "TUXEDO laptop (hardware drivers and Control Center)" false -}}
{{- $headless = promptBoolOnce . "headless" "Headless boot (second limine entry booting to multi-user.target; start the desktop on demand)" false -}}
{{- end -}}
{{- $devHost := promptStringOnce . "devHost" "MagicDNS hostname of the remote dev box, reached as `ssh <devHost>` (blank for none)" "" -}}
{{- $devUser := promptStringOnce . "devUser" "Username on the remote dev box (blank if it matches this machine's)" "" -}}

[data]
  profile = {{ $profile | quote }}
{{ if eq $profile "mac" }}  macMode = {{ $macMode | quote }}
{{ end }}
  org = {{ $org | quote }}
  gaming = {{ $gaming }}
  headless = {{ $headless }}
  ups = {{ $ups }}
  deck = {{ $deck }}
  tuxedo = {{ $tuxedo }}
  devHost = {{ $devHost | quote }}
  devUser = {{ $devUser | quote }}

[onepassword]
  mode = "account"
{{- if eq $profile "wsl" }}
  # No desktop app on WSL: reuse the session from `eval "$(op signin)"`
  # instead of re-prompting for the password on every op call.
  prompt = false
{{- end }}

{{ if eq $profile "mac" -}}
# Each chezmoi script is a separate process: brew shellenv in script 05
# cannot export PATH to fnm/go/tmux in subsequent scripts.
[scriptEnv]
  PATH = {{ printf "/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:%s" (env "PATH") | quote }}
{{ end -}}
