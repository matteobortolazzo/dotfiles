# Homebrew filters custom environment variables; HOMEBREW_* survives that filter.
mac_mode = ENV.fetch("HOMEBREW_CHEZMOI_MAC_MODE", "full-dev")
raise "HOMEBREW_CHEZMOI_MAC_MODE must be minimal or full-dev" unless %w[minimal full-dev].include?(mac_mode)

