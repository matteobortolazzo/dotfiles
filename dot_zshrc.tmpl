# Path
{{ if eq .profile "main" -}}
export PATH=/opt/webp:$PATH
{{ end -}}
export PATH="$HOME/.config/scripts:$PATH"
export PATH="$HOME/.dotnet:$HOME/.dotnet/tools:$PATH"
export PATH="$HOME/.aspire/bin:$PATH"
export PATH="$HOME/.bun/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"
{{ if eq .profile "mac" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ end -}}

# Editor
export EDITOR=nvim
export VISUAL=nvim

# Environment Variables
export DOTNET_ROOT="$HOME/.dotnet"
export DOTNET_CLI_TELEMETRY_OPTOUT=1
{{ if eq .profile "wsl" -}}
# This box is deliberately isolated from the Windows filesystem: /etc/wsl.conf
# sets [automount] enabled=false, so /mnt/c is empty and no *.exe is reachable
# (no wslview, no clip.exe, no powershell.exe — so no wsl2-ssh-agent bridge to
# the Windows 1Password agent either). Everything below stays Linux-side.
# Clipboard still works: WSLg gives nvim/tmux a Wayland display + wl-clipboard.
#
# SSH keys live in the plain OpenSSH agent, socket-activated by systemd
# (ssh-agent.socket, enabled by run_once_after_60-wsl.sh). ~/.ssh/config has
# AddKeysToAgent yes, so first use of a key loads it.
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ssh-agent.socket"
{{ end -}}
export KUBECONFIG=~/.kube/config
export ZSH="$HOME/.oh-my-zsh"

# Android SDK — Android Studio is installed through JetBrains Toolbox, which
# only drops a launcher script in Toolbox/scripts: it exports no ANDROID_HOME
# and puts no adb/fastboot on PATH the way a distro android-sdk package would.
for _android_sdk in "$HOME/Android/Sdk" "$HOME/Library/Android/sdk"; do
    [ -d "$_android_sdk" ] || continue
    export ANDROID_HOME="$_android_sdk"
    export ANDROID_SDK_ROOT="$_android_sdk"   # deprecated, still read by Gradle/AGP
    for _android_bin in platform-tools emulator cmdline-tools/latest/bin; do
        [ -d "$ANDROID_HOME/$_android_bin" ] && export PATH="$ANDROID_HOME/$_android_bin:$PATH"
    done
    break
done
unset _android_sdk _android_bin

# `npx cap open android` only probes distro install paths (/opt/android-studio,
# /usr/local/android-studio, ~/.local/share/applications); point it at Toolbox.
for _studio in "$HOME/.local/share/JetBrains/Toolbox/scripts/studio" \
               "$HOME/Library/Application Support/JetBrains/Toolbox/scripts/studio"; do
    [ -x "$_studio" ] && export CAPACITOR_ANDROID_STUDIO_PATH="$_studio" && break
done
unset _studio

# fnm (curl-installer puts the binary in ~/.local/share/fnm; pacman/brew put
# it on PATH already — eval works either way)
FNM_PATH="$HOME/.local/share/fnm"
[ -d "$FNM_PATH" ] && export PATH="$FNM_PATH:$PATH"
command -v fnm >/dev/null && eval "$(fnm env)"

# Custom environment variables
if [ -f ~/.config/environment ]; then
    source ~/.config/environment
fi

# Oh My Zsh Configuration
ZSH_THEME="robbyrussell"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting zsh-vi-mode kubectl)
source $ZSH/oh-my-zsh.sh

# Alias
alias v="nvim"
alias lg="lazygit"
alias lb="lazyboards"
alias yz="yazi"
alias tn="tmux new-session -s"
alias tl="tmux list-sessions"
alias ta="tmux attach-session"
{{ if ne .profile "mac" -}}
command -v k3s >/dev/null && alias kubectl="k3s kubectl"
{{ end -}}
t() { tmux new-session -A -s "$(basename "$PWD")"; }

# zoxide initialization
eval "$(zoxide init zsh)"

# direnv — per-directory environment overrides
if command -v direnv &>/dev/null; then
  eval "$(direnv hook zsh)"
fi

# atuin — Ctrl-R history search. zsh-vi-mode defers its own init to the first
# precmd and rebinds every keymap, wiping anything bound here; hand the eval to
# its documented hook instead. Up arrow stays plain zsh, ? stays unbound.
if command -v atuin >/dev/null; then
  if (( ${+zvm_after_init_commands} )); then
    zvm_after_init_commands+=('eval "$(atuin init zsh --disable-up-arrow --disable-ai)"')
  else
    eval "$(atuin init zsh --disable-up-arrow --disable-ai)"
  fi
fi

# Load Angular CLI autocompletion.
if command -v ng &>/dev/null; then
  source <(ng completion script)
fi

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}
