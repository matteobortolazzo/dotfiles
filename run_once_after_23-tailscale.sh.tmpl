#!/usr/bin/env bash
{{ if or (eq .profile "main") (eq .profile "wsl") -}}
set -euo pipefail

if systemctl list-unit-files tailscaled.service >/dev/null 2>&1; then
  sudo systemctl enable --now tailscaled.service
fi
{{- if eq .profile "wsl" }}

# WSL: no NetworkManager, and /etc/resolv.conf belongs to WSL
# (generateResolvConf, a symlink into /mnt/wsl). tailscaled falls back to its
# "direct" DNS mode there: it backs up WSL's file and writes its own pointing
# at 100.100.100.100, which forwards non-tailnet queries to WSL's resolver and
# keeps its search domains. WSL only regenerates the file at boot, before
# tailscaled starts, so the two never fight at runtime. Don't also run
# Tailscale on the Windows side with networkingMode=mirrored: Linux would see
# both tailnet interfaces and routes.
{{- end }}
{{- if eq .profile "main" }}

# MagicDNS needs systemd-resolved to own /etc/resolv.conf. See
# system/NetworkManager/10-dns-systemd-resolved.conf for why the default NM
# arrangement trips Tailscale's health check even while lookups still work.
#
# Guarded on resolved actually running: pointing resolv.conf at a stub nothing
# serves would take out DNS entirely, and this script runs unattended.
if systemctl is-active --quiet systemd-resolved.service \
  && [ -f /run/systemd/resolve/stub-resolv.conf ]; then

  src="{{ .chezmoi.sourceDir }}/system/NetworkManager/10-dns-systemd-resolved.conf"
  target=/etc/NetworkManager/conf.d/10-dns-systemd-resolved.conf

  if ! { [ -f "$target" ] && sudo cmp -s "$src" "$target"; }; then
    sudo install -D -m 0644 -o root -g root "$src" "$target"
    echo "installed $target"
    # reload, not restart: restarting NM drops every active connection, and
    # this script can be running over the very SSH session it would kill.
    sudo systemctl reload NetworkManager.service
  fi

  # -h so an existing correct symlink is left alone; NM writes a regular file,
  # which is exactly the state being replaced.
  if [ ! -h /etc/resolv.conf ] \
    || [ "$(readlink -f /etc/resolv.conf)" != /run/systemd/resolve/stub-resolv.conf ]; then
    sudo ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
    echo "pointed /etc/resolv.conf at systemd-resolved's stub"
  fi
else
  echo "systemd-resolved not active — leaving /etc/resolv.conf alone"
fi
{{- end }}

if command -v tailscale >/dev/null 2>&1 && ! tailscale status >/dev/null 2>&1; then
  echo "tailscaled is up but this machine isn't on the tailnet — run 'sudo tailscale up'"
fi
{{ end -}}
