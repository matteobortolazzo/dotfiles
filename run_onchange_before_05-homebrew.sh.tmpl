#!/usr/bin/env bash
{{ if eq .profile "mac" -}}
set -euo pipefail
export HOMEBREW_CHEZMOI_MAC_MODE={{ dig "macMode" "full-dev" . | quote }}
case "$HOMEBREW_CHEZMOI_MAC_MODE" in
  minimal|full-dev) ;;
  *) echo "Invalid macMode: $HOMEBREW_CHEZMOI_MAC_MODE" >&2; exit 1 ;;
esac

# run_onchange: re-runs on `chezmoi apply` whenever the Brewfile changes.
# chezmoi hashes only this script's rendered content, not the Brewfile it reads
# at runtime, so the hash below is embedded to make edits retrigger it.
# brew bundle is idempotent (installed formulae/casks are skipped).
#
# --no-upgrade: only install what's missing, never upgrade what's already there.
# Self-updating casks (docker-desktop) reinstall via an uninstall step that needs
# sudo for /Library/PrivilegedHelperTools, which can't prompt from a chezmoi
# script and aborts the whole apply. Upgrades stay a manual `brew upgrade`.
#
# Brewfile: {{ include "packages/Brewfile" | sha256sum }}

# An existing Homebrew may not be on a fresh TTY's PATH yet.
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

if ! command -v brew >/dev/null; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  else
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

brewfile="{{ .chezmoi.sourceDir }}/packages/Brewfile"
[ -f "$brewfile" ] || { echo "no $brewfile — skipping"; exit 0; }

brew bundle --file="$brewfile" --no-upgrade
{{ end -}}
