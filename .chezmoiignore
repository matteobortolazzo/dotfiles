{{/* onepasswordRead with account-mode prompting first runs `op signin --raw`.
     Vault listing alone does not verify that handshake. Check both, discarding all
     output (signin can return a session token). Bound the combined check where GNU
     timeout is available, including Homebrew's gtimeout spelling. Redirect stdin so
     a source-state read never starts a terminal password prompt.
     `|| echo no` is required: output aborts on a non-zero exit. */ -}}
{{ $opProbe := "if command -v timeout >/dev/null 2>&1; then timeout 5 sh -c 'op signin --raw >/dev/null && op vault list >/dev/null'; elif command -v gtimeout >/dev/null 2>&1; then gtimeout 5 sh -c 'op signin --raw >/dev/null && op vault list >/dev/null'; else op signin --raw >/dev/null && op vault list >/dev/null; fi </dev/null >/dev/null 2>&1 && echo yes || echo no" -}}
{{ $opAuth := eq (trim (output "sh" "-c" $opProbe)) "yes" -}}
{{ if not $opAuth -}}
{{ if lookPath "op" -}}
{{ warnf "1Password cannot authenticate right now (no unlocked desktop app — normal over SSH): leaving ~/.config/environment untouched. Re-run `chezmoi apply` from a local session to refresh secrets." -}}
{{ else -}}
{{ warnf "1Password CLI not installed: skipping ~/.config/environment. Install `op`, sign in, then re-run `chezmoi apply`." -}}
{{ end -}}
.config/environment
{{ end -}}
