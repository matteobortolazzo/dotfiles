#!/usr/bin/env bash
# Mac mode: {{ if eq .profile "mac" }}{{ dig "macMode" "full-dev" . }}{{ else }}full-dev{{ end }}
{{ if and (eq .chezmoi.os "linux" "darwin") (not (and (eq .profile "mac") (eq (dig "macMode" "full-dev" .) "minimal"))) -}}
set -euo pipefail

# install path matches $DOTNET_ROOT in .zshrc
# Side-by-side with older SDKs: bump `channel` to move to the next major.
channel=11.0
if [ -x "$HOME/.dotnet/dotnet" ] \
  && "$HOME/.dotnet/dotnet" --list-sdks | grep -q "^${channel%%.*}\."; then
  exit 0
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
curl -fsSL -o "$tmp" https://dot.net/v1/dotnet-install.sh
chmod +x "$tmp"
"$tmp" --channel "$channel" --install-dir "$HOME/.dotnet"
{{ end -}}
