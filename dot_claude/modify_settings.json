#!/usr/bin/env bash
# Merge chezmoi-managed keys into ~/.claude/settings.json without clobbering
# the keys Claude Code writes at runtime.
#
# Claude Code owns this file too: auto-mode setup, /permissions additions,
# plugin toggles and onboarding flags are all written back to it at runtime.
# A plain managed file would fight those writes (chezmoi apply clobbers them,
# and chezmoi status stays permanently dirty). So this is a `modify_` script:
# chezmoi pipes the current target on stdin and takes stdout as the new target.
#
# Rules:
#   - MANAGED  keys are forced on every machine (objects merge, arrays replace).
#              cenci is pinned `false` here rather than omitted: a plugin manifest's
#              defaultEnabled defaults to true, so deleting the entry would leave it on.
#              Re-enable it at project scope, in that project's .claude/settings.local.json,
#              which wins (resolution order: managed -> user -> project -> local).
#   - RETIRED  keys are deleted once, then stay gone unless something rewrites them.
#   - Anything else on disk is preserved untouched. That is deliberate: it is how
#     machine-local, repo-specific state (autoMode.environment, skipAutoPermissionPrompt)
#     stays on the machine that needs it and out of this public repo.
#
# Note: the merge cannot delete a managed key by removing it here — move it to
# RETIRED for one release instead.

set -euo pipefail

