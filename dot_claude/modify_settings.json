# Keys deliberately removed. Each entry is a jq path expression.
#   .hooks                                  - was an empty PreToolUse array, no effect
#   .env.CLAUDE_AUTOCOMPACT_PCT_OVERRIDE    - test-only knob, inert while autoCompactEnabled is false
#   .env.CLAUDE_CODE_SUBAGENT_MODEL         - hard-overrides every agent's frontmatter `model:`,
#                                             which downgraded cenci's opus-pinned planner/refiner/
#                                             security-reviewer to sonnet. Unset lets frontmatter win.
#   .extraKnownMarketplaces.cenci.source.ref - temporary branch pin (watch/v0.56.1); object merge is
#                                             recursive, so it survives unless deleted explicitly.
RETIRED='del(.hooks, .env.CLAUDE_AUTOCOMPACT_PCT_OVERRIDE, .env.CLAUDE_CODE_SUBAGENT_MODEL, .extraKnownMarketplaces.cenci.source.ref)'

current=$(cat)

# First apply on a fresh machine runs before the package scripts install jq.
if ! command -v jq >/dev/null 2>&1; then
  if [ -n "${current//[[:space:]]/}" ]; then
    printf '%s' "$current"   # leave an existing file alone rather than mangling it
  else
    printf '%s\n' "$MANAGED"
  fi
  exit 0
fi

# Treat an absent or corrupt target as empty rather than failing the apply.
if [ -z "${current//[[:space:]]/}" ] || ! printf '%s' "$current" | jq -e . >/dev/null 2>&1; then
  current='{}'
fi

# -S sorts keys so the output is canonical and the merge converges after one apply,
# instead of producing a fresh diff every time Claude Code rewrites the file.
jq -S -n --argjson cur "$current" --argjson man "$MANAGED" \
  "(\$cur * \$man) | ${RETIRED} | if (.env? // {}) == {} then del(.env) else . end"
