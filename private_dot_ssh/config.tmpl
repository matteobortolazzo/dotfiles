{{- if ne (dig "gaming" false .) true }}
# Remote dev on the gaming / sim-rig desktop. Agent forwarding rather than a key
# on that box: its 1Password agent socket needs an unlocked GUI, which an SSH
# session doesn't have. Rename to match your Tailscale MagicDNS hostname.
Host desktop
    ForwardAgent yes

{{ end -}}
Host *
    AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else if eq .profile "wsl" }}
    # No IdentityAgent: keys come from the plain OpenSSH agent that systemd
    # socket-activates (SSH_AUTH_SOCK set in .zshrc). There's no 1Password
    # socket to point at — the Linux app isn't installed, and the Windows
    # agent is unreachable because /etc/wsl.conf disables automount, so
    # /mnt/c is empty and no *.exe (including powershell.exe) can be run.
{{- else }}
    IdentityAgent ~/.1password/agent.sock
{{- end }}
