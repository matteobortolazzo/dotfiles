{{- $devHost := dig "devHost" "" . -}}
{{- $devUser := dig "devUser" "" . -}}
{{- if and $devHost (ne $devHost .chezmoi.hostname) }}
# Remote dev on the desktop, over Tailscale — works from any network without
# forwarding a port. Linux targets authenticate through Tailscale SSH; Mac
# Remote Login and LAN recovery use keys. Forward an agent only for a specific
# command that needs it (`ssh -A`), rather than every dev connection.
#
# The host comes from the `devHost` data var, and the block is skipped when it
# matches this machine's hostname — a box should never carry an entry pointing
# at itself, and Tailscale derives the MagicDNS name from the system hostname,
# so the comparison is exact.
#
# It's the short MagicDNS name, not the FQDN: every tailnet member gets the
# tailnet suffix pushed as a DNS search domain, so the short name resolves on
# its own and the tailnet ID stays out of a public repo. If a client has
# MagicDNS off, set devHost to <host>.<tailnet>.ts.net instead.
#
# User comes from `devUser`, set only where the local username differs from
# the one on the desktop (the Mac); left out, ssh uses the local name.
Host {{ $devHost }}
{{- if $devUser }}
    User {{ $devUser }}
{{- end }}

{{ end -}}
Host *
    ForwardAgent no
    AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else if eq .profile "wsl" }}
    # No IdentityAgent: keys come from the plain OpenSSH agent that systemd
    # socket-activates (SSH_AUTH_SOCK set in .zshrc). There's no 1Password
    # socket to point at — the Linux app isn't installed, and no bridge to
    # the Windows agent is set up.
{{- else }}
    IdentityAgent ~/.1password/agent.sock
{{- end }}
