#!/usr/bin/env bash
{{ if and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id") (eq .chezmoi.osRelease.id "cachyos" "arch") (eq .profile "main") (dig "dev" false .) -}}
set -euo pipefail

# ufw ships (and CachyOS's installer leaves) a default-deny inbound policy with
# an empty rule set. That state is silent by design: sshd binds 0.0.0.0:22 and
# logs "Server listening", the port shows up in `ss -tlnp`, and every inbound
# SYN is still dropped in netfilter before sshd ever sees it — the journal has
# no connection line to hint at it. So the port has to be opened explicitly
# alongside 27-sshd, or a dev box looks up and answers nothing.
#
# Rules are added *before* the enable, so this is safe to run over SSH. On
# re-runs, new scoped rules are added *before* the old unscoped ones are
# deleted for the same reason.
#
# Everything is scoped to the LAN subnet or the tailscale interface. This box
# sits behind NAT, so unscoped rules were never remotely reachable — but
# Docker-published ports have already shown that "behind NAT" is the only line
# of defense a blanket allow leaves, and Sunshine's 47990 is an admin web UI
# that can run arbitrary commands. Scoping costs nothing.

if ! command -v ufw >/dev/null 2>&1; then
  echo "ufw not installed — skipping (it's in arch-system.txt)"
  exit 0
fi

lan="192.168.1.0/24"

# Plain `allow`, deliberately not `limit`. ufw's limiter counts packets that
# conntrack labels NEW rather than connections, and `nf_conntrack_tcp_loose=1`
# (the kernel default) makes it pick up a mid-stream packet whose conntrack
# entry is gone as a fresh flow. A long-idle SSH session that resumes therefore
# trips 6-in-30s on its own retransmits — four landed inside one second here —
# and because ufw's first rule does `recent --set` on every NEW packet
# *including the ones it is about to reject*, each retry refreshes the 30s
# window. The block then sustains itself for as long as the client keeps
# trying, and since `ufw-user-limit` ends in `-j REJECT` the symptom is an
# instant "Connection refused" on new logins too, not a timeout. There is also
# nothing here to rate-limit: 27-sshd sets PasswordAuthentication no and
# KbdInteractiveAuthentication no, so the brute force this was blunting cannot
# happen.
sudo ufw allow from "$lan" to any port 22 proto tcp comment 'ssh (lan)'

# Tailscale traffic is already authenticated by the tailnet, and the peer IPs
# are not knowable up front — allow SSH on the interface rather than by source.
# Kept to port 22: allowing the whole interface would expose every listener on
# the box to the tailnet.
sudo ufw allow in on tailscale0 to any port 22 proto tcp comment 'ssh over tailscale'

# LocalSend (docs/localsend.md). Two ports, same number, both required and for
# different reasons — dropping either fails in a way that looks like the other
# device is broken rather than like a firewall:
#   udp = discovery. Peers announce to the multicast group 224.0.0.167:53317;
#         `to any` covers that destination, which is not a LAN unicast address.
#         Blocked, the desktop never appears in anyone's device list.
#   tcp = the HTTP(S) API that carries the actual transfer. Blocked, the
#         desktop is visible but every send to it stalls at 0%.
sudo ufw allow from "$lan" to any port 53317 proto udp comment 'localsend discovery (lan)'
sudo ufw allow from "$lan" to any port 53317 proto tcp comment 'localsend transfer (lan)'

# Off-LAN, over the tailnet. Multicast doesn't traverse Tailscale, so there is
# no UDP counterpart here on purpose: discovery is manual (add the peer by its
# MagicDNS IP) and only the TCP transfer API is ever reached this way.
sudo ufw allow in on tailscale0 to any port 53317 proto tcp comment 'localsend over tailscale'

{{ if dig "gaming" false . -}}
# Moonlight -> Sunshine, LAN clients only (the TV). Enabling a default-deny
# firewall without these silently kills couch streaming: the client just fails
# to find the host. Ports are Sunshine's defaults (base port 47989); change
# them here if the base moves. 47990 is the admin web UI — LAN-scoped on
# purpose, and Sunshine's own origin_web_ui_allowed=lan backs it up.
sudo ufw allow from "$lan" to any port 47984:47990 proto tcp comment 'sunshine control + web ui (lan)'
sudo ufw allow from "$lan" to any port 48010 proto tcp comment 'sunshine rtsp (lan)'
sudo ufw allow from "$lan" to any port 47998:48000 proto udp comment 'sunshine video/audio/control (lan)'
sudo ufw allow from "$lan" to any port 48002 proto udp comment 'sunshine mic (lan)'
sudo ufw allow from "$lan" to any port 48010 proto udp comment 'sunshine rtsp (lan)'

{{ end -}}
# Migration: drop the pre-scoping blanket rules if a previous run added them.
# `ufw delete` on a rule that doesn't exist just says so and exits 0.
sudo ufw delete limit 22/tcp >/dev/null 2>&1 || true

# Migration: replace the scoped `limit` rule with the `allow` above. Deleted
# after the allow is added, so this stays safe to run over the SSH session it
# governs.
sudo ufw delete limit from "$lan" to any port 22 proto tcp >/dev/null 2>&1 || true
sudo ufw delete allow 47984:47990/tcp >/dev/null 2>&1 || true
sudo ufw delete allow 48010/tcp >/dev/null 2>&1 || true
sudo ufw delete allow 47998:48000/udp >/dev/null 2>&1 || true
sudo ufw delete allow 48002/udp >/dev/null 2>&1 || true
sudo ufw delete allow 48010/udp >/dev/null 2>&1 || true

if sudo ufw status | grep -q '^Status: active'; then
  sudo ufw reload
  echo "ufw already active — rules added and reloaded"
else
  sudo ufw --force enable
  echo "ufw enabled with the rules above"
fi

sudo ufw status verbose
{{ end -}}
