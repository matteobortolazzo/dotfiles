#!/usr/bin/env bash
{{ if and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id") (eq .chezmoi.osRelease.id "cachyos" "arch") (eq .profile "main") -}}
set -euo pipefail

# Every native Linux machine is an SSH target, including laptops. The old dev
# flag is ignored; development tools and remote access are shared defaults.
#
# Tailscale (run_once_after_23-tailscale.sh.tmpl) covers off-LAN access; this is
# for plain `ssh <devHost>` + tmux on the local network. Opening the port in the
# firewall is 28-firewall's job — sshd listening is not the same as reachable.

if ! systemctl cat sshd.service >/dev/null 2>&1; then
  echo "sshd.service not installed — skipping (openssh is in arch-terminal.txt)"
  exit 0
fi

sudo systemctl enable --now sshd.service

# Only harden once a key is actually installed. Writing PasswordAuthentication
# no with an empty authorized_keys would lock out every remote login.
keys="$HOME/.ssh/authorized_keys"
conf=/etc/ssh/sshd_config.d/10-hardening.conf

if [ -s "$keys" ]; then
  desired='PasswordAuthentication no
PermitRootLogin no
KbdInteractiveAuthentication no'
  if ! [ -f "$conf" ] || [ "$(sudo cat "$conf")" != "$desired" ]; then
    printf '%s\n' "$desired" | sudo install -Dm644 /dev/stdin "$conf"
    sudo systemctl reload sshd.service
    echo "wrote $conf — password auth disabled"
  fi
else
  cat <<EOF

  sshd is running with password auth still enabled: $keys is missing or empty.
  From another machine:
      ssh-copy-id <this-host>
  then re-run just this script to harden (same idiom as the greetd script):
      chezmoi execute-template < "\$(chezmoi source-path)/run_once_after_27-sshd.sh.tmpl" | bash

EOF
fi
{{ else if and (eq .chezmoi.os "darwin") (eq .profile "mac") -}}
set -euo pipefail

# macOS owns its SSH daemon through Remote Login, not a Homebrew service.
# systemsetup requires Full Disk Access for the calling terminal on macOS.
remote_login_enabled() {
  sudo /usr/sbin/systemsetup -getremotelogin | grep -q 'Remote Login: On'
}
if ! remote_login_enabled; then
  # Verify too: systemsetup can report a permission error with exit status zero.
  if ! sudo /usr/sbin/systemsetup -setremotelogin on || ! remote_login_enabled; then
    echo "Enable Remote Login in System Settings > General > Sharing, then rerun chezmoi apply." >&2
    echo "Alternatively grant this terminal Full Disk Access before rerunning." >&2
    exit 1
  fi
fi
{{ end -}}
