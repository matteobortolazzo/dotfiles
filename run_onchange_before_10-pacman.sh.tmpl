#!/usr/bin/env bash
{{ if and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id") (eq .chezmoi.osRelease.id "cachyos" "arch") -}}
set -euo pipefail

# run_onchange: re-runs on `chezmoi apply` whenever a referenced list changes.
# chezmoi only hashes this script's rendered content, not the files it reads at
# runtime, so the list hashes below are embedded to make edits retrigger it.
# pacman --needed keeps re-runs idempotent (installed packages are skipped).
#
# arch-terminal.txt: {{ include "packages/arch-terminal.txt" | sha256sum }}
{{- if eq .profile "main" }}
# arch-desktop.txt:  {{ include "packages/arch-desktop.txt" | sha256sum }}
# arch-system.txt:   {{ include "packages/arch-system.txt" | sha256sum }}
{{- end }}
{{- if dig "gaming" false . }}
# arch-gaming.txt:   {{ include "packages/arch-gaming.txt" | sha256sum }}
{{- end }}
{{- if dig "dev" false . }}
# arch-dev.txt:      {{ include "packages/arch-dev.txt" | sha256sum }}
{{- end }}

src="{{ .chezmoi.sourceDir }}/packages"

pkg_terminal="$src/arch-terminal.txt"
[ -f "$pkg_terminal" ] && sudo pacman -Syu --needed --noconfirm - < "$pkg_terminal"

{{ if eq .profile "main" -}}
pkg_desktop="$src/arch-desktop.txt"
[ -f "$pkg_desktop" ] && sudo pacman -S --needed --noconfirm - < "$pkg_desktop"

pkg_system="$src/arch-system.txt"
[ -f "$pkg_system" ] && sudo pacman -S --needed --noconfirm - < "$pkg_system"
{{ end -}}

{{ if and (dig "gaming" false .) (eq .chezmoi.osRelease.id "cachyos") -}}
# CachyOS-only, unlike the other lists: cachyos-gaming-meta,
# gamescope-session-cachyos and linux-cachyos-headers live in the CachyOS repos
# and would abort the whole transaction on stock Arch.
#
# lib32-nvidia-utils is listed explicitly even though steam only needs "a lib32
# Vulkan driver": with --noconfirm pacman auto-picks the first provider, which
# can be lib32-mesa. Naming it pins the NVIDIA one.
pkg_gaming="$src/arch-gaming.txt"
[ -f "$pkg_gaming" ] && sudo pacman -S --needed --noconfirm - < "$pkg_gaming"
{{ end -}}

{{ if dig "dev" false . -}}
# Plain Arch repos, unlike arch-gaming.txt: safe on any profile, so this is
# gated on the `dev` role alone rather than also on `profile == "main"`.
pkg_dev="$src/arch-dev.txt"
[ -f "$pkg_dev" ] && sudo pacman -S --needed --noconfirm - < "$pkg_dev"
{{ end -}}

{{ if eq .profile "wsl" -}}
# wl-clipboard: WSLg exposes a Wayland display, giving nvim/tmux-yank a
# working clipboard provider.
sudo pacman -S --needed --noconfirm docker docker-buildx docker-compose wl-clipboard
{{ end -}}
{{ end -}}
