#!/usr/bin/env bash
# Mac mode: {{ if eq .profile "mac" }}{{ dig "macMode" "full-dev" . }}{{ else }}full-dev{{ end }}
{{ if and (eq .chezmoi.os "linux" "darwin") (not (and (eq .profile "mac") (eq (dig "macMode" "full-dev" .) "minimal"))) -}}
set -euo pipefail

command -v rustup >/dev/null && exit 0
[ -x "$HOME/.cargo/bin/rustup" ] && exit 0

curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
{{ end -}}
