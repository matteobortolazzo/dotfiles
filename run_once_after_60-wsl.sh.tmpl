#!/usr/bin/env bash
{{ if and (eq .chezmoi.os "linux") (eq .profile "wsl") -}}
set -euo pipefail

# WSL host configuration. Pair with the Windows-side settings documented in
# docs/wslconfig.example (memory cap, mirrored networking, autoMemoryReclaim).

# /etc/wsl.conf — systemd so services (docker) work, and no Windows filesystem:
# automount off keeps the distro isolated from C:, appendWindowsPath off keeps
# zsh command lookup/completion fast. The trade-off is that no *.exe is
# reachable, so wslview/clip.exe/powershell.exe (and any agent bridge built on
# them) are out — .zshrc and ~/.ssh/config are written for that.
# Takes effect after `wsl --shutdown` from Windows.
if ! [ -f /etc/wsl.conf ]; then
  sudo tee /etc/wsl.conf >/dev/null <<'EOF'
[boot]
systemd=true

[interop]
appendWindowsPath=false

[automount]
enabled=false
EOF
  echo "wrote /etc/wsl.conf — run 'wsl --shutdown' from Windows to apply"
elif ! grep -q 'appendWindowsPath' /etc/wsl.conf; then
  echo "NOTE: /etc/wsl.conf exists but doesn't set appendWindowsPath=false —"
  echo "      consider adding [interop] appendWindowsPath=false for faster shells"
fi

# Docker engine inside WSL (requires systemd; no-op until first restart if
# systemd isn't up yet).
if command -v dockerd >/dev/null 2>&1; then
  sudo systemctl enable docker.service 2>/dev/null \
    || echo "systemd not active yet — docker.service will need enabling after wsl --shutdown"
  sudo usermod -aG docker "$USER"
fi

# SSH agent, Linux-side. With automount off there is no path to the Windows
# 1Password agent (that bridge needs powershell.exe under /mnt/c), so this
# profile uses plain ssh-agent. The socket unit starts it on first connect;
# .zshrc points SSH_AUTH_SOCK at $XDG_RUNTIME_DIR/ssh-agent.socket, which is
# exactly what the packaged unit expects.
systemctl --user enable ssh-agent.socket 2>/dev/null \
  || echo "systemd --user not up yet — enable ssh-agent.socket after wsl --shutdown"
{{ end -}}
