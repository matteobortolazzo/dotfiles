#!/usr/bin/env bash
{{ if eq .chezmoi.os "linux" "darwin" -}}
set -euo pipefail

if [ ! -d "$HOME/.oh-my-zsh" ]; then
  RUNZSH=no CHSH=no KEEP_ZSHRC=yes \
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
fi

# CHSH=no above skips the installer's own (interactive) chsh prompt; set the
# shell ourselves so it stays idempotent. Distros like CachyOS default fresh
# accounts to fish, which silently drifts every shell config in this repo out
# of effect until the login shell is fixed to zsh.
# macOS has no getent; read the login shell from Directory Services instead.
if command -v getent >/dev/null 2>&1; then
  current_shell="$(getent passwd "$USER" | cut -d: -f7)"
else
  current_shell="$(dscl . -read "/Users/$USER" UserShell | awk '{print $2}')"
fi
if [ "$current_shell" != "/bin/zsh" ]; then
  sudo chsh -s /bin/zsh "$USER"
fi
{{ end -}}
